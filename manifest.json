{
  "manifest_version": 3,
  "name": "ChatGPT Prompt Grabber",
  "version": "1.0",
  "description": "Grabs text typed into ChatGPT",
  "host_permissions": [
  "https://chatgpt.com/*",
  "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": 
      ["https://chatgpt.com/*"
    , "https://gemini.google.com/*"
  ],
      "js": ["content.js"]
    }
  ]
}